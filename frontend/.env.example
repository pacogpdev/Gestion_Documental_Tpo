# API URL — inlined at build time by Vite (VITE_* vars are NOT available at runtime).
#
# Local development (Vite dev server at :5173 hitting backend at :8000):
#   VITE_API_URL=http://localhost:8000/api
#
# Docker / Kubernetes (nginx serves the frontend AND reverse-proxies /api to backend):
#   VITE_API_URL=/api
#
# This file is safe to commit. Do NOT put secrets here — Vite inlines them into the bundle.
# Create a local .env (git-ignored) to override these defaults during development.

VITE_API_URL=http://localhost:8000/api
